{
  "name": "qa-ai-practical-assessment",
  "version": "1.0.0",
  "description": "AI-assisted Playwright automation framework for UI and API testing",
  "private": true,
  "scripts": {
    "test": "playwright test --project=ui-chromium --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --project=ui-chromium --project=api --grep @smoke",
    "test:regression": "playwright test --project=ui-chromium --project=api --grep @regression",
    "test:ui:smoke": "playwright test --project=ui-chromium --grep @smoke",
    "test:ui:regression": "playwright test --project=ui-chromium --grep @regression",
    "test:api:smoke": "playwright test --project=api --grep @smoke",
    "test:api:regression": "playwright test --project=api --grep @regression",
    "test:headed": "playwright test --project=ui-chromium --project=api --headed",
    "test:debug": "playwright test --project=ui-chromium --project=api --debug",
    "report": "playwright show-report reports/html",
    "report:open": "playwright show-report reports/html --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "globals": "^15.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
